# OPTIONAL. The dashboard works without this file (prices from Upstox's public 1-minute
# candles). Fill it in only if you want tick-by-tick streaming through Angel One.
# Copy this file to ".env" and fill in your own values.
# Never share this file or paste these values anywhere (including chat).
#
# 1. API key   : smartapi.angelbroking.com -> My Apps -> your app -> API Key
# 2. Client code: your Angel One login ID (e.g. A123456)
# 3. MPIN       : the 4-digit MPIN you use to log in to Angel One
# 4. TOTP secret: smartapi.angelbroking.com -> Enable TOTP -> the text secret
#                 shown beside the QR code (a long string of letters/digits)

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Optional: port for the dashboard server
PORT=8000
